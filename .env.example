# Copy to .env (never commit .env) and set real passwords.
POSTGRES_USER=mtc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mtc
# Host port for Postgres (5432 is often taken by a local install)
POSTGRES_PORT=5434
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
# Used by `python mtc_logger.py run` (host) so the password stays out of shell history:
# MTC_DB_URL=postgresql://mtc:change-me@localhost:5434/mtc
