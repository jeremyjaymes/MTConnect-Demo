          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, device, tool, previous_tool FROM (\n  SELECT ts AS time, device, value AS tool, LAG(value) OVER (PARTITION BY device, data_item_id ORDER BY ts, id) AS previous_tool\n  FROM observations WHERE type = 'ToolNumber' AND value <> 'UNAVAILABLE' AND device IN ($device)) t\nWHERE $__timeFilter(time) ORDER BY time DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
