    {
      "id": 6,
      "type": "table",
      "title": "Time in each state (selected range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
