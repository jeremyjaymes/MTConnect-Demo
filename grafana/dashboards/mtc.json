    {
      "id": 10,
      "type": "stat",
      "title": "Powered-on time (from machine counter)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT device, SUM(seconds) AS value FROM accumulated_time_hourly WHERE device IN ($device) AND hour >= date_trunc('hour', $__timeFrom()::timestamptz) AND hour <= $__timeTo() AND sub_type = 'x:TOTAL' GROUP BY device ORDER BY device"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "device",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "description": "The machine's own timers: total_time (powered on) updates about every 2 minutes, auto_time and cut_time about every 10 seconds while running. Shares are approximate over short ranges."
    },
    {
