  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current state",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (device) device, state FROM events WHERE device IN ($device) ORDER BY device, ts DESC, id DESC"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "device",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "state",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ACTIVE": {
                  "color": "green",
                  "index": 0
                },
                "READY": {
                  "color": "blue",
                  "index": 1
                },
                "PROGRAM_COMPLETED": {
                  "color": "light-blue",
                  "index": 2
                },
                "FEED_HOLD": {
                  "color": "yellow",
                  "index": 3
                },
                "WAIT": {
                  "color": "yellow",
                  "index": 4
                },
