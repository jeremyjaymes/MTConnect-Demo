    {
      "id": 4,
      "type": "stat",
      "title": "Utilization today",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT device,\n       COALESCE(SUM(d) FILTER (WHERE state = 'ACTIVE'), 0)\n         / NULLIF(SUM(d) FILTER (WHERE state NOT IN ('UNAVAILABLE', 'AGENT_RESTART')), 0) AS utilization\nFROM (SELECT device, state,\n             EXTRACT(EPOCH FROM LEAST(end_ts, $__timeTo()) - GREATEST(start_ts, $__timeFrom())) AS d\n      FROM state_intervals\n      WHERE device IN ($device) AND end_ts > $__timeFrom() AND start_ts < $__timeTo()) i\nGROUP BY device ORDER BY device"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "device",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "utilization",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "timeFrom": "now/d"
    },
