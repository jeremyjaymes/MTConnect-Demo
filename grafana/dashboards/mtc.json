    {
      "id": 13,
      "type": "timeseries",
      "title": "Machine time per hour: in-cycle and cutting (minutes, from machine counters)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hour AS time, device,\n       SUM(seconds) FILTER (WHERE sub_type = 'x:AUTO') / 60.0 AS in_cycle,\n       SUM(seconds) FILTER (WHERE sub_type = 'x:CUT') / 60.0 AS cutting\nFROM accumulated_time_hourly WHERE device IN ($device) AND hour >= date_trunc('hour', $__timeFrom()::timestamptz) AND hour <= $__timeTo() GROUP BY hour, device ORDER BY hour"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 1
          },
          "displayName": "${__field.labels.device} ${__field.name}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*in_cycle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*cutting"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "description": "The machine's own timers: total_time (powered on) updates about every 2 minutes, auto_time and cut_time about every 10 seconds while running. Shares are approximate over short ranges."
