            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT device, EXTRACT(EPOCH FROM now() - MAX(ts)) AS seconds FROM events WHERE device IN ($device) GROUP BY device ORDER BY device"
        }
      ],
