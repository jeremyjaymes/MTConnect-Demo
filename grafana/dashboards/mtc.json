    {
      "id": 3,
      "type": "state-timeline",
      "title": "State timeline (24h)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "timeFrom": "24h",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT GREATEST(start_ts, $__timeFrom()) AS time, device, state\nFROM state_intervals\nWHERE device IN ($device) AND end_ts >= $__timeFrom() AND start_ts <= $__timeTo()\nORDER BY 1"
        }
      ],
