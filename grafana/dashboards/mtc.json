    {
      "id": 9,
      "type": "table",
      "title": "Machine snapshot (latest values)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (device, data_item_id) device, type, value\n  FROM observations WHERE device IN ($device) ORDER BY device, data_item_id, ts DESC, id DESC)\nSELECT device,\n       MAX(value) FILTER (WHERE type = 'Execution') AS state,\n       MAX(value) FILTER (WHERE type = 'ControllerMode') AS mode,\n       MAX(value) FILTER (WHERE type = 'Program' AND value NOT IN ('UNAVAILABLE', '')) AS program,\n       MAX(value) FILTER (WHERE type = 'ToolNumber') AS tool,\n       MAX(value) FILTER (WHERE type = 'WorkOffset') AS work_offset,\n       MAX(value) FILTER (WHERE type = 'DoorState') AS door,\n       MAX(value) FILTER (WHERE type = 'EmergencyStop') AS e_stop,\n       MAX(CASE WHEN type = 'PartCount' AND value ~ '^[0-9]+$' THEN value::int END) AS part_count,\n       MAX(CASE WHEN type = 'RotaryVelocity' AND value ~ '^-?[0-9.]+$' THEN value::float END) AS spindle_rpm\nFROM latest GROUP BY device ORDER BY device"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACTIVE": {
                        "color": "green",
                        "index": 0
                      },
                      "READY": {
                        "color": "blue",
                        "index": 1
                      },
                      "PROGRAM_COMPLETED": {
                        "color": "light-blue",
                        "index": 2
                      },
                      "FEED_HOLD": {
                        "color": "yellow",
                        "index": 3
                      },
                      "WAIT": {
                        "color": "yellow",
                        "index": 4
                      },
                      "INTERRUPTED": {
                        "color": "orange",
                        "index": 5
                      },
                      "STOPPED": {
                        "color": "orange",
                        "index": 6
                      },
                      "PROGRAM_STOPPED": {
                        "color": "orange",
                        "index": 7
                      },
                      "OPTIONAL_STOP": {
                        "color": "orange",
                        "index": 8
                      },
                      "UNAVAILABLE": {
                        "color": "dark-red",
                        "index": 9
                      },
                      "AGENT_RESTART": {
                        "color": "purple",
                        "index": 10
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "door"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
