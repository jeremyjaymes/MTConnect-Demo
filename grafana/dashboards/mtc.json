      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT device, state,\n       SUM(d) AS seconds,\n       SUM(d) / SUM(SUM(d)) OVER (PARTITION BY device) AS share\nFROM (SELECT device, state,\n             EXTRACT(EPOCH FROM LEAST(end_ts, $__timeTo()) - GREATEST(start_ts, $__timeFrom())) AS d\n      FROM state_intervals\n      WHERE device IN ($device) AND end_ts > $__timeFrom() AND start_ts < $__timeTo()) i\nGROUP BY device, state ORDER BY device, seconds DESC"
        }
      ],
      "options": {
