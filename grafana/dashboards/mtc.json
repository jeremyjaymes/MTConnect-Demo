      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT device, level, type, native_code AS code, message, start_ts AS since,\n       EXTRACT(EPOCH FROM now() - start_ts) AS active_for\nFROM active_conditions\nWHERE device IN ($device)\nORDER BY level DESC, start_ts"
