    {
      "id": 14,
      "type": "table",
      "title": "Why did it stop? (feed hold / interrupted / stopped, with nearby conditions and door)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtc-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.start_ts AS time, s.device, s.state, s.duration_seconds AS duration,\n       (SELECT string_agg(DISTINCT c.level || ' ' || c.type || ' ' || c.native_code || ': ' || c.message, '; ')\n        FROM condition_intervals c\n        WHERE c.device = s.device AND c.start_ts BETWEEN s.start_ts - interval '5 minutes' AND s.end_ts) AS conditions_within_5_min,\n       EXISTS (SELECT 1 FROM observations o\n               WHERE o.device = s.device AND o.type = 'DoorState' AND o.value IN ('OPEN', 'UNLATCHED')\n                 AND o.ts BETWEEN s.start_ts AND s.end_ts) AS door_opened\nFROM state_intervals s\nWHERE s.device IN ($device) AND s.start_ts BETWEEN $__timeFrom() AND $__timeTo()\n  AND s.state NOT IN ('ACTIVE', 'READY', 'UNAVAILABLE', 'AGENT_RESTART', 'DATA_GAP')\nORDER BY s.start_ts DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACTIVE": {
                        "color": "green",
                        "index": 0
                      },
                      "READY": {
                        "color": "blue",
                        "index": 1
                      },
                      "PROGRAM_COMPLETED": {
                        "color": "light-blue",
                        "index": 2
                      },
                      "FEED_HOLD": {
                        "color": "yellow",
                        "index": 3
                      },
                      "WAIT": {
                        "color": "yellow",
                        "index": 4
                      },
                      "INTERRUPTED": {
                        "color": "orange",
                        "index": 5
                      },
                      "STOPPED": {
                        "color": "orange",
                        "index": 6
                      },
                      "PROGRAM_STOPPED": {
                        "color": "orange",
                        "index": 7
                      },
                      "OPTIONAL_STOP": {
                        "color": "orange",
                        "index": 8
                      },
                      "UNAVAILABLE": {
                        "color": "dark-red",
                        "index": 9
                      },
                      "AGENT_RESTART": {
                        "color": "purple",
                        "index": 10
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Tool changes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 12,
        "h": 8
      },
      "targets": [
