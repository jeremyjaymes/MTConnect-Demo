          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT start_ts AS time, device, level, type, native_code AS code, severity, message,\n       EXTRACT(EPOCH FROM COALESCE(end_ts, now()) - start_ts) AS duration,\n       CASE WHEN end_ts IS NULL THEN 'active' ELSE 'cleared' END AS status\nFROM condition_intervals\nWHERE device IN ($device) AND start_ts BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY start_ts DESC"
