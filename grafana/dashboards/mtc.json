    {
      "id": 7,
      "type": "table",
      "title": "Active conditions (warnings & faults)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtc-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 6
